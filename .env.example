# Modelo das variáveis de ambiente. Os valores reais estão na Vercel
# (Settings → Environment Variables). Para os trazer para o teu computador:
#
#   vercel env pull .env.local
#
# Nunca ponhas valores reais neste ficheiro: ele vai para o Git.

# Supabase (públicas: chegam ao browser; a segurança está nas políticas RLS)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Só servidor — nunca com prefixo NEXT_PUBLIC_. Só são precisas quando as rotas
# em src/app/api/ estiverem implementadas.
# SUPABASE_SERVICE_ROLE_KEY=
# LIVEKIT_URL=
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# PAYPAL_CLIENT_ID=
# PAYPAL_SECRET=
