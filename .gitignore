# Dependências / ferramentas locais (não fazem parte do site publicado)
node_modules/
.netlify/
.DS_Store
Thumbs.db
*.log
npm-debug.log*

# Ficheiros de ambiente. A chave anon do Supabase é pública por desenho (vai no js/config.js
# e a segurança real está nas políticas RLS), mas a service_role NÃO pode ir para o Git:
# ignora todas as políticas e dá acesso total à base de dados.
.env
.env.*
!.env.example
*.local

# Credenciais do LiveKit e do PayPal (usadas só por scripts locais, nunca pelo site)
livekit.key
paypal.secret

# Service workers gerados por ferramentas de PWA (o sw.js é escrito à mão, ver netlify.toml)
workbox-*.js
sw.js.map
